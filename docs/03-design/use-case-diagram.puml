@startuml
title Silsila System - Use Case Diagram
left to right direction

actor Student
actor Contributor
actor Reviewer
Contributor <|-- Reviewer

rectangle "Silsila System" {
  usecase "Browse Categories" as UC_Browse
  usecase "Search Issue" as UC_Search
  usecase "View Chain" as UC_Chain
  usecase "Compare Madhab Positions" as UC_Compare
  usecase "Login" as UC_Login
  usecase "Propose Link" as UC_Propose
  usecase "Review Pending Links" as UC_Review
  usecase "Approve Link" as UC_Approve
  usecase "Reject Link" as UC_Reject
}

Student --> UC_Browse
Student --> UC_Search
Student --> UC_Chain
Student --> UC_Compare
Contributor --> UC_Propose
Reviewer --> UC_Review

UC_Compare .> UC_Chain : <<extend>>
UC_Propose .> UC_Login : <<include>>
UC_Review .> UC_Login : <<include>>
UC_Approve .> UC_Review : <<extend>>
UC_Reject .> UC_Review : <<extend>>
@enduml
